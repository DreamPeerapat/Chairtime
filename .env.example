# App connection — a NON-superuser role, so row-level security actually applies.
DATABASE_URL=postgresql://chairtime:chairtime@localhost:5432/chairtime

# Owner/DDL connection used by drizzle-kit and the migrator.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/chairtime

# Separate database for `pnpm test:integration` (wiped on every run).
DATABASE_URL_TEST=postgresql://chairtime:chairtime@localhost:5432/chairtime_test
DATABASE_URL_TEST_ADMIN=postgresql://postgres:postgres@localhost:5432/chairtime_test

# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# Signs staff session cookies. Generate the same way.
SESSION_SECRET=

# Shared secret for /api/cron/* endpoints.
CRON_SECRET=

# Public origin, used to build LIFF/webhook links and the OAuth redirect_uri.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LINE Login channel (separate from any shop's own LINE OA — see CLAUDE.md
# iron rule #6). Redirect URI to register: {NEXT_PUBLIC_APP_URL}/auth/callback/line
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# ChairTime's own LINE OA — the third LINE thing, and not either of the other
# two. Not a shop's OA: this is how the platform reaches a shop OWNER with
# news and with the receipt for their subscription, which is the only channel
# that works on the day they pay, before their own OA exists.
#
# Two steps, and the second is easy to miss:
#
#   1. Paste this OA's Messaging API channel access token below.
#
#   2. In the LINE console, link that OA to the Login channel above, and make
#      sure BOTH sit under the SAME provider. The signup screen's "add friend"
#      tickbox comes from that link (lib/auth/oauth.ts sends bot_prompt, which
#      LINE ignores until it exists), and the same provider is what makes the
#      user id we keep at login (auth_identity.provider_uid) the id this OA can
#      push to. Under two different providers the tickbox works, every push
#      400s, and nothing about the setup looks wrong.
#
# Left empty, the platform copy of the receipt stays queued rather than being
# thrown away — the shop's own OA copy is unaffected.
LINE_PLATFORM_OA_TOKEN=

# Google OAuth client. Redirect URI to register: {NEXT_PUBLIC_APP_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The operator's view across every shop (/admin). Comma-separated staff_user
# ids. Deliberately not a database column: a row saying "this user is an
# admin" is a row the application's own role can write, and any write it could
# be tricked into would become an escalation across every shop. Leave unset
# and nobody is an operator.
PLATFORM_ADMIN_STAFF_IDS=

# Slip verification (SlipOK). The platform's own account, never a shop's —
# it is our bank the slips are checked against. Leave the key unset and a
# shop's payment behaves as it always has: the period extends on trust and
# the row waits for a human. Set it and a slip that does not match the
# transfer is refused before anything is extended.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# Only for pointing at a sandbox; the default is SlipOK's own endpoint.
SLIPOK_API_URL=

# ใบเสร็จออกที่ระบบงานเข้า ไม่ได้ออกที่นี่ — เลขที่เอกสารต้องเดินชุดเดียวกับ
# งานฟรีแลนซ์ และสิ้นปีรายรับทั้งหมดต้องอยู่ในสมุดเล่มเดียว
# ตั้งเป็น https://ngankhao.com ตอน deploy
NGANKHAO_API_URL=
# ต้องตรงกับ INTEGRATION_SECRET ฝั่งงานเข้าเป๊ะๆ
# ถ้าเว้นว่าง การชำระเงินยังทำงานปกติทุกอย่าง แค่ไม่มีใบเสร็จออกให้
NGANKHAO_INTEGRATION_SECRET=
